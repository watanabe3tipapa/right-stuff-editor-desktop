{
  "name": "right-stuff-editor-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Right-Stuff Editor Desktop — a local-first writing workspace built with tinyjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "tsc -p tsconfig.json && tsc -p src/backend/tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/backend/tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run",
    "preview": "vite preview",
    "applefm:build": "bash applefm/build.sh",
    "applefm": "npm run applefm:build && ./applefm/build/apple-fm-server",
    "package": "tinyjs build && bash scripts/postbuild-macos.sh"
  },
  "dependencies": {
    "@lexical/code": "0.17.1",
    "@lexical/history": "0.17.1",
    "@lexical/list": "0.17.1",
    "@lexical/mark": "0.17.1",
    "@lexical/markdown": "0.17.1",
    "@lexical/react": "0.17.1",
    "@lexical/rich-text": "0.17.1",
    "@lexical/selection": "0.17.1",
    "@lexical/utils": "0.17.1",
    "@tailwindcss/typography": "^0.5.13",
    "@wterm/dom": "^0.1.9",
    "@wterm/react": "^0.1.9",
    "dexie": "^4.0.4",
    "dexie-react-hooks": "^1.1.7",
    "html-react-parser": "^5.1.18",
    "katex": "^0.19.0",
    "lexical": "0.17.1",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "turndown": "^7.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "oxlint": "^1.88.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  }
}
