{
  "name": "right-stuff-editor-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Right-Stuff Editor Desktop — a local-first writing workspace built with tinyjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000 --strictPort",
    "build": "tsc -p tsconfig.json && tsc -p src/backend/tsconfig.json && vite build",
    "build:landing": "vite build --config vite.landing.config.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p src/backend/tsconfig.json",
    "lint": "oxlint src",
    "test": "vitest run",
    "preview": "vite preview",
    "applefm:build": "bash applefm/build.sh",
    "applefm": "npm run applefm:build && ./applefm/build/apple-fm-server",
    "package": "tinyjs build && bash scripts/postbuild-macos.sh",
    "package:universal": "tinyjs build --universal && bash scripts/postbuild-macos.sh",
    "dist:universal": "npm run package:universal && bash scripts/make-universal-artifacts.sh"
  },
  "dependencies": {
    "@lexical/code": "^0.32.0",
    "@lexical/history": "^0.32.0",
    "@lexical/link": "^0.32.0",
    "@lexical/list": "^0.32.0",
    "@lexical/mark": "^0.32.0",
    "@lexical/markdown": "^0.32.0",
    "@lexical/react": "^0.32.0",
    "@lexical/rich-text": "^0.32.0",
    "@lexical/selection": "^0.32.0",
    "@lexical/table": "^0.32.0",
    "@lexical/utils": "^0.32.0",
    "@tailwindcss/typography": "^0.5.13",
    "@tailwindcss/vite": "^4.3.3",
    "@wterm/dom": "^0.1.9",
    "@wterm/react": "^0.1.9",
    "html-react-parser": "^5.1.18",
    "katex": "^0.19.0",
    "lexical": "^0.32.0",
    "mermaid": "^11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.0",
    "turndown": "^7.2.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.1",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.5",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:watanabe3tipapa/right-stuff-editor-desktop.git"
  },
  "homepage": "https://github.com/watanabe3tipapa/right-stuff-editor-desktop"
}
